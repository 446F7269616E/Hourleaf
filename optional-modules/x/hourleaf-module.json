{
  "schemaVersion": 1,
  "format": "hourleaf.local-module",
  "id": "hourleaf.local.x-focus",
  "name": "X",
  "author": "Hourleaf contributors",
  "version": "1.0.1",
  "description": "隐藏 X 网页主页时间线中的普通帖子。",
  "matches": ["https://x.com/*"],
  "domainPolicy": "timed",
  "hideSelectors": [],
  "filterGroups": [
    {
      "id": "home-timeline",
      "name": "主页时间线",
      "description": "隐藏主页时间线中的普通帖子卡片。",
      "selectors": [
        "main [data-testid='primaryColumn']:has(a[href='/home'][role='tab'][aria-selected='true']) [data-testid='cellInnerDiv']:has(article[data-testid='tweet']):not(:has([data-testid='placementTracking']))"
      ]
    }
  ],
  "cssFiles": [],
  "userScriptFiles": []
}
